rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // OAuth tokens — Server / Admin SDK only
    match /tokens/{userId} {
      allow read, write: if false;
    }

    // Global invitation lookup index
    match /invites_index/{inviteId} {
      allow create, read, update: if isAuthenticated();
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow create, read, update: if isAuthenticated();
      allow delete: if false;

      match /emailEvents/{eventId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /sendAttempts/{attemptId} {
        allow read, write: if false;
      }

      match /mailboxCaps/{docId} {
        allow read, write: if false;
      }

      match /stats/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
