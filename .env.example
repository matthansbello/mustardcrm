# Mustard Environment Variables

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared workspace — everyone who signs in joins this one org and sees all contacts
MUSTARD_WORKSPACE_ID=org_mustard
MUSTARD_WORKSPACE_NAME=Mustard Workspace
# Comma-separated emails that are always admins (others join as reps)
MUSTARD_ADMIN_EMAILS=you@example.com

# Sign-in methods shown on /login and /signup (enable each one in Firebase Auth → Sign-in method)
# Options: google,microsoft,apple,github,password,emaillink
NEXT_PUBLIC_AUTH_METHODS=google,microsoft,apple,github,password,emaillink

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Local testing: `npm run emulators`, then set this to true to use the Auth/Firestore/Storage emulators
# NEXT_PUBLIC_FIREBASE_EMULATORS=true

# Firebase Admin SDK (Server / Cloud Functions)
# Easiest: paste the whole service-account JSON (Firebase console → Project settings →
# Service accounts → Generate new private key) as ONE value. Use this OR the pair below, not both.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
# Check credentials any time with: npm run check:firebase
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Google Workspace OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Zoho Mail (optional) — lets people send sequences from mailboxes hosted in Zoho Mail.
# Create a "Server-based Application" at https://api-console.zoho.com, enable Multi-DC, and add
# https://<your-domain>/api/auth/zoho/callback as an Authorized Redirect URI.
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
# Optional: defaults to https://<request domain>/api/auth/zoho/callback
# ZOHO_REDIRECT_URI=https://crm.example.com/api/auth/zoho/callback
# Optional: where the consent screen starts (default https://accounts.zoho.com; Multi-DC routes users to their region)
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu

# Token encryption (REQUIRED in production — min 32 characters)
TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret_key_32chars_min

# Cron / internal API protection
CRON_SECRET=replace_with_random_cron_secret

# Gmail Pub/Sub topic for users.watch (Phase 3)
GMAIL_PUBSUB_TOPIC=projects/your_project_id/topics/gmail-push

# Cloud Functions / Backend Endpoints
NEXT_PUBLIC_CLOUD_FUNCTIONS_URL=https://us-central1-your_project_id.cloudfunctions.net
